# ==============================================================================
# StockWise AI - Global Environment Configuration Example
# Copy this file to .env for local no-Docker or Docker development
# ==============================================================================

# Backend API Settings
STOCKWISE_ENV=development
STOCKWISE_API_HOST=127.0.0.1
STOCKWISE_API_PORT=8000
STOCKWISE_API_DEBUG=true
STOCKWISE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (Local Persistent SQLite)
# For local dev without Docker, path relative to services/api or absolute:
STOCKWISE_DATABASE_URL=sqlite:///../../data/stockwise.db

# Seed & Simulator Configuration
STOCKWISE_SIMULATOR_SEED=42
STOCKWISE_NUM_PRODUCTS=24
STOCKWISE_NUM_WAREHOUSES=4
STOCKWISE_NUM_DESTINATIONS=16

# Frontend Settings (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000
